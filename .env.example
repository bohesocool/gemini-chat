# Gemini Chat 环境变量配置

# ============ 登录密码 ============
# 登录密码（可选）
# 如果不设置，将使用默认密码 adminiadmin，首次登录后需修改
VITE_AUTH_PASSWORD=

# ============ 运行环境 ============
# NODE_ENV=production

# ============ 数据库配置 ============
# 数据库总开关（默认 false，关闭时使用浏览器 IndexedDB 存储）
# DB_ENABLED=true

# 数据库类型：sqlite / mysql / postgresql（默认 sqlite）
# DB_TYPE=sqlite

# 数据库连接字符串（DSN）
# SQLite:      SQL_DSN=file:/app/data/gemini-chat.db
# MySQL:       SQL_DSN=mysql://root:123456@localhost:3306/gemini-chat
# PostgreSQL:  SQL_DSN=postgresql://root:123456@postgres:5432/gemini-chat
# SQL_DSN=file:/app/data/gemini-chat.db

# ============ WebDAV 同步配置 ============
# WebDAV 同步开关（需同时启用数据库）
# WEBDAV_ENABLED=true

# WebDAV 服务器地址
# WEBDAV_URL=https://your-webdav-server/dav/

# WebDAV 认证
# WEBDAV_USER=username
# WEBDAV_PASSWORD=password
# 推荐：用 Docker secrets，把密码写入文件，并设置 WEBDAV_PASSWORD_FILE 指向该文件
# WEBDAV_PASSWORD_FILE=/run/secrets/webdav_password

# 自动同步间隔（秒，默认 300 = 5分钟）
# WEBDAV_SYNC_INTERVAL=300

# 备份加密密钥（可选，设置后备份将 AES-256-GCM 加密）
# 建议用 WEBDAV_ENCRYPTION_KEY_FILE 通过 Docker secrets 挂载
# WEBDAV_ENCRYPTION_KEY=your-encryption-key-or-passphrase
# WEBDAV_ENCRYPTION_KEY_FILE=/run/secrets/webdav_encryption_key

# ============ 后端安全配置 ============
# JWT 签名密钥；不设置则每次重启生成临时密钥（所有旧 token 失效）
# JWT_SECRET=change-me-to-a-random-long-string
# JWT_SECRET_FILE=/run/secrets/jwt_secret

# 允许的前端来源，逗号分隔；'*' 表示允许所有（不推荐）
# 同域部署可留空，跨域必须配置
# CORS_ORIGINS=https://chat.example.com,https://admin.example.com
