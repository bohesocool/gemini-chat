# ============================================================
# Gemini Chat 环境变量配置
# ------------------------------------------------------------
# 这是 docker-compose 读取的唯一配置来源。
# 使用方式：
#   cp .env.example .env
#   # 然后按需修改下方的值
#
# 启动命令：
#   SQLite（默认）:         docker compose up -d
#   MySQL（内置容器）:      docker compose --profile mysql up -d
#   PostgreSQL（内置容器）: docker compose --profile postgres up -d
#   同时启用 WebDAV：       追加 --profile webdav，例如:
#                            docker compose --profile mysql --profile webdav up -d
# ============================================================


# ============ 登录密码 ============
# 前端登录密码。留空则使用默认密码 adminiadmin（首次登录后请立刻修改）
VITE_AUTH_PASSWORD=

# ============ 运行环境 ============
# production / development；生产环境务必保持 production（错误详情脱敏）
NODE_ENV=production


# ============ 数据库配置 ============
# 数据库总开关：
#   false（默认）→ 浏览器 IndexedDB 存储
#   true         → 服务端数据库（sqlite / mysql / postgresql）
DB_ENABLED=false

# 数据库类型：sqlite / mysql / postgresql
DB_TYPE=sqlite

# 数据库连接字符串（DSN）。示例：
#   SQLite:      file:/app/data/gemini-chat.db（留空即走此默认）
#   MySQL:       mysql://root:123456@mysql:3306/gemini-chat
#   PostgreSQL:  postgresql://root:123456@postgres:5432/gemini-chat
# 注意：MySQL / PostgreSQL 用内置容器时，主机名就是服务名 mysql / postgres
SQL_DSN=


# ============ WebDAV 同步配置（需同时启用数据库） ============
WEBDAV_ENABLED=false

# WebDAV 服务器地址（末尾斜杠必带）
# 使用内置 dufs 容器（--profile webdav）时填：http://dufs:5000/
WEBDAV_URL=

# WebDAV 账号 / 密码
WEBDAV_USER=
WEBDAV_PASSWORD=
# 推荐：用 Docker secrets，把密码写入文件，设置该变量指向该文件
# WEBDAV_PASSWORD_FILE=/run/secrets/webdav_password

# 自动同步间隔（秒，默认 300 = 5 分钟）
WEBDAV_SYNC_INTERVAL=300

# 备份加密密钥（可选，强烈建议）。设置后备份将 AES-256-GCM 加密
# 建议用 WEBDAV_ENCRYPTION_KEY_FILE 通过 Docker secrets 挂载
WEBDAV_ENCRYPTION_KEY=
# WEBDAV_ENCRYPTION_KEY_FILE=/run/secrets/webdav_encryption_key


# ============ 后端安全配置 ============
# JWT 签名密钥；不设置则每次重启生成临时密钥（所有旧 token 失效）
# 生成方法：openssl rand -hex 32
JWT_SECRET=
# JWT_SECRET_FILE=/run/secrets/jwt_secret

# 允许的前端来源，逗号分隔；留空表示允许所有来源（同域部署可留空，跨域必须配置）
# 示例：CORS_ORIGINS=https://chat.example.com,https://admin.example.com
CORS_ORIGINS=


# ============================================================
# 以下变量仅在启用对应 --profile 时生效
# ============================================================

# ============ MySQL 容器（--profile mysql） ============
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=gemini-chat
# 宿主机暴露端口（生产务必删除或设为内网 IP）
MYSQL_PORT=3306

# ============ PostgreSQL 容器（--profile postgres） ============
POSTGRES_USER=root
POSTGRES_PASSWORD=123456
POSTGRES_DB=gemini-chat
POSTGRES_PORT=5432

# ============ WebDAV 对端 dufs 容器（--profile webdav） ============
# 仅用于测试/本地，不建议生产启用
DUFS_PORT=5000
# dufs 的 --auth 参数格式：<user>:<password>@<path>:<permission>
# 默认 admin / secret
DUFS_AUTH=admin:secret@/:rw
