# Gemini Chat Server 环境变量

# ============ 运行环境 ============
NODE_ENV=development

# 服务端口
PORT=8080

# 静态文件目录（前端构建产物）
STATIC_DIR=../dist

# ============ 数据库 ============
# 数据库开关
DB_ENABLED=true

# 数据库类型：sqlite / mysql / postgresql
DB_TYPE=sqlite

# 数据库连接（Prisma DSN 格式）
# SQLite:      SQL_DSN=file:./data/gemini-chat.db
# MySQL:       SQL_DSN=mysql://root:123456@localhost:3306/gemini-chat
# PostgreSQL:  SQL_DSN=postgresql://root:123456@localhost:5432/gemini-chat
SQL_DSN=file:./data/gemini-chat.db

# ============ 认证 ============
# 登录密码哈希，推荐加盐 scrypt 格式：node scripts/hash-password.js <password> 生成
# 兼容旧的无盐 sha256 hex 格式（会打印告警）
# docker-entrypoint 会从 VITE_AUTH_PASSWORD 自动生成
# AUTH_PASSWORD_HASH=
# AUTH_PASSWORD_HASH_FILE=/run/secrets/auth_password_hash

# JWT 签名密钥；不设置则每次重启生成临时密钥（所有旧 token 失效）
# JWT_SECRET=change-me-to-a-random-long-string
# JWT_SECRET_FILE=/run/secrets/jwt_secret

# ============ CORS ============
# 允许的前端来源，逗号分隔；'*' 表示允许所有（不推荐）
# 同域部署可留空
# CORS_ORIGINS=https://chat.example.com,https://admin.example.com

# ============ WebDAV 同步 ============
# WEBDAV_ENABLED=true
# WEBDAV_URL=https://your-webdav-server/dav/
# WEBDAV_USER=username
# WEBDAV_PASSWORD=password
# 推荐：用 Docker secrets，把密码写入文件，并设置 WEBDAV_PASSWORD_FILE 指向该文件
# WEBDAV_PASSWORD_FILE=/run/secrets/webdav_password
# WEBDAV_SYNC_INTERVAL=300

# 备份加密密钥（可选，设置后备份将用 AES-256-GCM 加密）
# WEBDAV_ENCRYPTION_KEY=your-encryption-key
# WEBDAV_ENCRYPTION_KEY_FILE=/run/secrets/webdav_encryption_key
