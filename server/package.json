{
  "name": "gemini-chat-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:set-provider": "node scripts/set-db-provider.js",
    "db:generate": "npm run db:set-provider && prisma generate",
    "db:migrate": "npm run db:set-provider && prisma migrate deploy",
    "db:push": "npm run db:set-provider && prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "prisma": "^6.6.0",
    "webdav": "^5.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "~5.6.2"
  }
}
